        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "owner": "sahilraikwars-team",
    "extra": {
      "eas": {
        "projectId": "082ff27c-d2d1-44c0-a523-08145882a654"
